# ============================================
# متغيرات البيئة - Environment Variables
# ============================================
# قم بنسخ هذا الملف إلى .env وملء القيم الحقيقية
# Copy this file to .env and fill in real values

# مفتاح سري للتطبيق (استخدم سلسلة عشوائية طويلة)
# Secret key for Flask (use a long random string)
SECRET_KEY=your-secret-key-here-change-in-production

# رابط قاعدة البيانات
# Database URL
# محليًا يمكن تركه فارغًا لاستخدام SQLite داخل instance/anter.db.
# في Render يجب ضبطه على PostgreSQL/Supabase؛ لا تستخدم SQLite للإنتاج.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# مسار التخزين الدائم للصور والفيديوهات على Render
# Set this to the mounted persistent-disk path, for example /var/data/uploads
# UPLOAD_FOLDER=/var/data/uploads
# ملاحظة: القرص الدائم في Render يحتاج تهيئة من لوحة الخدمة؛ لا يكفي هذا المتغير وحده.

# إعدادات مكالمات WebRTC. STUN الافتراضي مناسب للتجربة، أما الإنتاج فيتطلب TURN موثوقًا.
# WEBRTC_STUN_URL=stun:stun.l.google.com:19302
# WEBRTC_TURN_URL=turn:turn.example.com:3478
# WEBRTC_TURN_USERNAME=your-turn-username
# WEBRTC_TURN_CREDENTIAL=your-turn-password

# مسار لوحة التحكم الإدارية السري (سيتم توليده تلقائياً إذا لم تحدده)
# Secret admin panel path (will be auto-generated if not set)
# ADMIN_PATH=admin-xxxxxxxxxxxx

# ============================================
# إعدادات إضافية اختيارية
# Optional additional settings
# ============================================

# بيئة التطبيق: development / production
# FLASK_ENV=development

# وضع التصحيح
# FLASK_DEBUG=True

# عنوان البريد الإلكتروني للتنبيهات
# ADMIN_EMAIL=admin@example.com
